
.data
.text
inicio: add $t0, $t1, $t2
addu $t0, $t1, $t2
sub $t0, $t1, $t2
subu $t0, $t1, $t2
mul $t0, $t1, $t2
and $t0, $t1, $t2
or $t0, $t1, $t2
xor $t0, $t1, $t2
nor $t0, $t1, $t2
slt $t0, $t1, $t2

move $s0, $t0
div $t0, $t1
mflo $s1
mfhi $s2
addi $t0, $t0, -1
sll $t1, $t1, 2
srl $t1, $t1, 0x1F
.data
contador: .word 0
.text
laco:
beq $t0, $zero, fim
bne $t0, $1, laco
blt $t0, $t1, laco
ble $t0, $t1, laco
bgt $t0, $t1, laco
bge $t0, $t1, laco
jal rotina
j fim
rotina: jr $ra
j rotulo_inexistente
fim:
fim:
nop
syscall
